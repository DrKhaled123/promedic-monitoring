# AI Monitoring Agent Environment Configuration
# Copy this to .env and fill in your values

# SMTP Settings for Email Alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
ALERT_EMAIL=admin@promedic1.com

# Notification Settings
ENABLE_EMAIL_ALERTS=false
ALERT_ON_FAILURE_ONLY=true

# Monitoring Settings (override config.js)
# RETRIES=3
# RETRY_DELAY=5000
# SLOW_REQUEST_THRESHOLD=3000
